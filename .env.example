# Copy this file to .env and adjust the values.

# ── vault ──────────────────────────────────────────────────────────────────────
# Absolute path to your Obsidian vault on the host machine.
VAULT_HOST_PATH=/Users/yourname/Documents/MyVault

# Path inside the container (no need to change unless you customise the compose file).
VAULT_PATH=/vault

# ── Ollama ─────────────────────────────────────────────────────────────────────
OLLAMA_URL=http://ollama:11434
# Use any model you have pulled, e.g. deepseek-r1:7b, qwen3:8b, llama3:8b
OLLAMA_MODEL=deepseek-r1:7b

# ── n8n ────────────────────────────────────────────────────────────────────────
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# Optional: enable basic-auth on the n8n UI
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme

GENERIC_TIMEZONE=UTC
TZ=UTC
